{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhadaway14/learn-ai/schemas/phase-project-increment.schema.json",
  "title": "Learn AI phase-project increment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "increment_id", "phase", "lesson", "capability", "upstream_evidence", "contract", "acceptance_criteria", "failure_behavior", "verification", "downstream_consumer", "decision"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "increment_id": {"type": "string", "pattern": "^P[1-6]-I[0-9]{2}$"},
    "phase": {"type": "integer", "minimum": 1, "maximum": 6},
    "lesson": {"type": "integer", "minimum": 1, "maximum": 35},
    "capability": {"type": "string", "minLength": 20},
    "upstream_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "interfaces", "assumptions", "trust_boundaries"],
      "properties": {
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/interfaceItem"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/interfaceItem"}},
        "interfaces": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "trust_boundaries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "failure_behavior": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedure", "expected_evidence"],
      "properties": {
        "procedure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "automated_command": {"type": ["string", "null"]}
      }
    },
    "downstream_consumer": {"type": "string", "minLength": 5},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "open_questions"],
      "properties": {
        "status": {"enum": ["proposed", "accepted", "revised", "replaced"]},
        "rationale": {"type": "string", "minLength": 10},
        "open_questions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "interfaceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "meaning", "type_or_shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 3},
        "type_or_shape": {"type": "string", "minLength": 1},
        "available_when": {"type": "string"}
      }
    }
  }
}
