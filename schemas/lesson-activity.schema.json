{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rhadaway14/learn-ai/schemas/lesson-activity.schema.json",
  "title": "Learn AI lesson activity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activity_id", "lesson", "mission", "starting_state", "levels", "evidence", "artifact", "acceptance_criteria", "recovery", "phase_increment"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "activity_id": {"type": "string", "pattern": "^L(0[1-9]|[12][0-9]|3[0-5])-A[1-9][0-9]*$"},
    "lesson": {"type": "integer", "minimum": 1, "maximum": 35},
    "title": {"type": "string", "minLength": 3},
    "mission": {"type": "string", "minLength": 20},
    "estimated_minutes": {"type": "integer", "minimum": 5},
    "starting_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point", "requirements", "known_good_state"],
      "properties": {
        "entry_point": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "known_good_state": {"type": "string", "minLength": 10},
        "compose_profile": {"type": ["string", "null"]}
      }
    },
    "learner_decisions": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guided", "challenge", "engineer_extension"],
      "properties": {
        "guided": {"$ref": "#/$defs/activityLevel"},
        "challenge": {"$ref": "#/$defs/activityLevel"},
        "engineer_extension": {"$ref": "#/$defs/activityLevel"}
      }
    },
    "failure_experiment": {"$ref": "#/$defs/experiment"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format", "path_or_download", "fields"],
      "properties": {
        "name": {"type": "string", "minLength": 3},
        "format": {"enum": ["markdown", "json", "csv", "image", "source", "model", "report", "other"]},
        "path_or_download": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "recovery": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "phase_increment": {"type": "string", "pattern": "^P[1-6]-I[0-9]{2}$"}
  },
  "$defs": {
    "activityLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "steps", "expected_observation"],
      "properties": {
        "objective": {"type": "string", "minLength": 10},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "expected_observation": {"type": "string", "minLength": 10},
        "optional": {"type": "boolean"}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "prediction", "failure_signal", "recovery"],
      "properties": {
        "change": {"type": "string", "minLength": 5},
        "prediction": {"type": "string", "minLength": 5},
        "failure_signal": {"type": "string", "minLength": 5},
        "recovery": {"type": "string", "minLength": 5}
      }
    }
  }
}
